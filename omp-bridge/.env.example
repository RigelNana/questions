# Shared by relay + agent + browser
OMP_BRIDGE_TOKEN=change-me-to-a-long-random-string

# Relay (cloud)
OMP_BRIDGE_HOST=0.0.0.0
OMP_BRIDGE_PORT=8787
# OMP_BRIDGE_STATIC=/opt/omp-bridge/web-dist

# Agent (LAN host)
OMP_BRIDGE_URL=wss://your-vps.example.com/ws
OMP_BRIDGE_ROOM=default
OMP_BRIDGE_ROOT=/home/you/projects
OMP_BRIDGE_CWD=/home/you/projects
# OMP_BIN=/usr/local/bin/omp
