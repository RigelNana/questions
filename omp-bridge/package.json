{
  "name": "omp-bridge",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Oh My Pi remote bridge: relay + local agent + web console (no public IP required)",
  "bin": {
    "omp-bridge": "./dist/cli.js"
  },
  "scripts": {
    "dev:relay": "tsx src/relay/index.ts",
    "dev:agent": "tsx src/agent/index.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "npm run build:server && npm run build:web",
    "build:server": "tsc -p tsconfig.json",
    "build:web": "vite build --config web/vite.config.ts",
    "start:relay": "node dist/relay/index.js",
    "start:agent": "node dist/agent/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "test": "tsx --test test/*.test.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/node": "^24.12.2",
    "@types/ws": "^8.18.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tsx": "^4.20.5",
    "typescript": "~5.9.3",
    "vite": "^8.0.4",
    "@xterm/xterm": "^5.5.0",
    "@xterm/addon-fit": "^0.10.0"
  }
}
